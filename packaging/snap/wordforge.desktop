[Desktop Entry]
Type=Application
Name=Wordforge
GenericName=Word Processor
Comment=Write and edit documents: DOCX, PDF export, spell check
Keywords=word;processor;document;editor;writer;docx;office;text;pdf;
Exec=wordforge %f
Icon=${SNAP}/meta/gui/wordforge.svg
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/x-wordforge;text/plain;
StartupWMClass=Wordforge
