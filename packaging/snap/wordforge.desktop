[Desktop Entry]
Type=Application
Name=Wordforge
GenericName=Word Processor
Comment=Write and edit documents: DOCX, PDF export, spell check
Keywords=word;processor;document;editor;writer;docx;doc;office;text;pdf;rich text;letter;report;microsoft word;
Exec=wordforge %f
Icon=${SNAP}/meta/gui/wordforge.svg
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/x-wordforge;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;
StartupWMClass=Wordforge
