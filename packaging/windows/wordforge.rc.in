#include <winver.h>

IDI_ICON1 ICON "@WORDFORGE_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Wordforge contributors"
      VALUE "FileDescription", "Wordforge word processor"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Wordforge"
      VALUE "LegalCopyright", "Apache License 2.0"
      VALUE "OriginalFilename", "Wordforge.exe"
      VALUE "ProductName", "Wordforge"
      VALUE "ProductVersion", "@PROJECT_VERSION@ (@WORDFORGE_BUILD_ID@)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
